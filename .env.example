# PIEify Platform — Environment Template
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to version control.

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable-anon-key>"
# Service role key must never be exposed to the browser; use only in server/edge functions.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Anthropic (AI extraction & question generation)
ANTHROPIC_API_KEY="<anthropic-api-key>"

# Optional: Resend (transactional email)
RESEND_API_KEY="<resend-api-key>"

# Optional: Stripe (subscriptions)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<stripe-publishable-key>"
STRIPE_SECRET_KEY="<stripe-secret-key>"
STRIPE_WEBHOOK_SECRET="<stripe-webhook-secret>"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
